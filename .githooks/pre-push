#!/usr/bin/env bash
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    base="$remote_oid"
    if [[ "$base" =~ ^0+$ ]]; then
        if git rev-parse --verify upstream/master >/dev/null 2>&1; then
            base=upstream/master
        else
            base=origin/master
        fi
    fi
    python3 scripts/check_publication.py --base "$base" --ref "$local_oid"
done

# AGY2API 公開設定範例（不含真實帳密）
# 複製為私有 .env 後設定兩個不同的隨機長密碼，權限設為 600。
# .env、DB、憑證、備份、日誌、OAuth callback URL 不得提交到 GitHub。
# 詳細部署步驟、驗收門檻及限制見 DEPLOY.md。
# web.py 載入 .env 時不覆寫既有 process environment。
# 一般優先順序：非空環境變數 > 資料庫設定 > 程式預設。
# 留空通常回退資料庫值，並不代表清除資料庫中的舊設定。
# 非空環境值會鎖定相關面板設定；修改 .env 後重啟服務。
# Docker 要用 env_file 或明確 environment；宿主 .env 不會自動全部注入容器。

# ── 監聽與程序 ────────────────────────────────────────────────
# native / Linux host-network：只監聽本機，再經 HTTPS 代理或受控 VPN 存取。
# Docker bridge：容器內改為 0.0.0.0，宿主僅發布 127.0.0.1:7861:7861。
HOST=127.0.0.1
PORT=7861
# OAuth 回呼只支援單程序；原生入口與 lifespan 拒絕 WORKERS 不為 1。
# DB 設定已即時讀取，但不代表多 worker / HA 支援。
WORKERS=1
# 僅在反代保留此前綴時設定，例如 /AGY2API；反代已剝除則留空。
PATH_PREFIX=

# ── 認證（必填的私密值）───────────────────────────────────────
# API 用戶端的 Bearer / API key；不要用在管理面板登入。
API_PASSWORD=
# 管理面板專用密碼，應與 API_PASSWORD 不同；面板可管理及匯出憑證。
PANEL_PASSWORD=
# 不支援以舊變數 PASSWORD 取代以上兩個設定。

# ── 儲存與帳號 ────────────────────────────────────────────────
# 未設 POSTGRESQL_URI 時使用 SQLite：${CREDENTIALS_DIR}/credentials.db。
# 本範例放在已忽略的 data/ 內；程式未設此變數時預設為 ./creds。
# DB 含 email、原始 OAuth token / refresh token、project ID 與設定，須備份及限制權限。
# native 可改為 /opt/agy2api/data/creds；容器範例另覆寫為 /app/creds。
CREDENTIALS_DIR=./data/creds
# 私密連線字串；非空時啟用 PostgreSQL，並非自動高可用或備援。
# 格式：postgresql://<user>:<password>@<private-host>:5432/<database>
POSTGRESQL_URI=
# cache：會話親和（建議）；random：隨機；sticky：盡量保持目前帳號。
# 親和不保證上游 prompt cache 命中；帳號不可用時仍可切換同模型帳號。
CREDENTIAL_SELECT_MODE=cache
# Redis 已列入鎖定相依；空值使用記憶體。明確設定後連線失敗會拒絕啟動。
# 運行中失聯時 readiness 回 503，本地後備不代表共享親和仍有效。
# URL 帳密／主機名為私密值。
REDIS_URL=

# ── Google 與代理 ─────────────────────────────────────────────
# 認證代理格式：http(s)://<user>:<password>@<host>:<port> 或 socks5(h)://...
# 代理會接觸上游流量，僅使用可信任服務；不要公開含認證的 URL。
PROXY=
OAUTH_PROXY_URL=https://oauth2.googleapis.com
GOOGLEAPIS_PROXY_URL=https://www.googleapis.com
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com
# OAuth loopback callback 起始埠；佔用時可能另選，應看當次 auth URL。
# 遠端 VPS 使用面板貼上 callback URL 或 SSH tunnel；callback URL 含一次性機密。
OAUTH_CALLBACK_PORT=11451

# ── 模型身分與內容 ────────────────────────────────────────────
# 預設維持精確模型 ID。只有 ALLOW_MODEL_REWRITE=1 且規則啟用時才允許復寫。
ALLOW_MODEL_REWRITE=0
MODEL_REWRITE_ENABLED=false
MODEL_REWRITE_RULES=[]
# 敏感詞過濾會修改送往模型的內容，不是日誌憑證遮罩；預設關閉以避免資訊損失。
SENSITIVE_WORDS_ENABLED=false
SENSITIVE_WORDS=
# 原有 API 的思考內容顯示設定；Responses 路徑另有自己的 reasoning 行為，見 RESPONSES_API.md。
RETURN_THOUGHTS_TO_FRONTEND=true
# 僅在客戶端刻意使用「抗截断-」模型前綴時啟用續傳處理，可能額外呼叫上游。
ANTI_TRUNCATION_MAX_ATTEMPTS=3

# ── Responses API ──────────────────────────────────────────────
# Responses 路徑：Claude 工具歷史仍保留 thinkingConfig，並回放支援的思考／簽章。
RESPONSES_CLAUDE_THINKING_WITH_TOOLS=1
# 預設拒絕會丟棄歷史的簽章／換帳號回退；允許降級必須明確選擇。
RESPONSES_ALLOW_HISTORY_FALLBACK=0
# 只有允許 history fallback 時，換帳號可移除舊簽章並回報降級。
RESPONSES_STRIP_SIG_ON_ACCOUNT_SWITCH=1
# reject 對未知頂層參數回 400；ignore 會忽略並回報，不代表支援該能力。
RESPONSES_UNKNOWN_PARAMS=reject
# 注意：reasoning.effort 不會映射模型；沒有 /responses/compact、內建搜尋等完整 Responses 能力。
# agy2 replay state 使用伺服器獨立金鑰認證加密；拒絕舊 agy1 封包。
# 空值時自動建立 CREDENTIALS_DIR/responses-state.key（600），必須一併備份。
# 明確設定須為 Fernet 32-byte URL-safe Base64 key，不可使用 API / panel 密碼。
# 金鑰遺失／輪替後舊歷史不能回放，需新對話；勿公開金鑰／原始對話。
RESPONSES_STATE_KEY=

# ── 錯誤與重試 ────────────────────────────────────────────────
AUTO_BAN=false
AUTO_BAN_ERROR_CODES=403
# 此範例保守停用共用請求層自動重試，可依需求調整。
# 串流交付內容後不重送；重試僅限尚未交付內容且設定啟用時。
# Responses 簽章回退與抗截斷續傳可能另發請求，並不受這個重試數控制。
# 程式未設定時預設為 enabled=true / max_retries=5 / interval=1。
RETRY_429_ENABLED=false
RETRY_429_MAX_RETRIES=0
RETRY_429_INTERVAL=1

# ── 三種獨立日誌開關 ──────────────────────────────────────────
# 應用程式診斷日誌；ENABLE_LOG=0 關閉此 logging 模組輸出，不等於上游／用戶端無留存。
ENABLE_LOG=1
LOG_LEVEL=info
# 預設讓 journald / Docker 管理控制台容量；不要再用無限制 stdout 重新導向。
LOG_CONSOLE=1
# 留空不寫檔。啟用時放在私有持久化目錄，例如 /opt/agy2api/data/app.log。
LOG_FILE=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUPS=2
LOG_TZ=Asia/Taipei
# DB 用量紀錄可含 client IP、帳號 email、模型、用量等。此範例關閉；程式預設 true。
USAGE_LOG_ENABLED=false
# 詳細錯誤日誌會保留請求本文、上游回覆及帳號識別。headers 遮罩不能清除本文個資。
# 除了受控除錯且有保留／清理政策外保持關閉；預設位置 data/request_logs/。
REQUEST_LOG_ENABLED=false
REQUEST_LOG_ERROR_CODES=400

# ── 選用 IP 白名單 ────────────────────────────────────────────
# 檢查範圍含管理面板與 API。支援 IP / CIDR / 起迄範圍，逗號或換行分隔。
# 規則可含私人網路拓撲，不要將真實列表寫回公開範例。
# 反代環境須先確認可信任的來源 IP 傳遞；防火牆仍應保護後端。
IP_WHITELIST_ENABLED=false
IP_WHITELIST=
